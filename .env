# Committed, non-secret defaults so that `pnpm dev` works straight after a clone.
# Override locally in .env.local (git-ignored). Never put a secret in either —
# every VITE_ variable is inlined into the client bundle and is therefore public.

# Run the MSW mock backend. Applies to `pnpm dev` and to the preview build that
# Playwright uses on CI, since there is no real API yet.
VITE_ENABLE_MSW=true

# Used only when VITE_ENABLE_MSW is false.
VITE_API_BASE_URL=http://localhost:3000/api

VITE_APP_ENV=development
