# Template for .env.local — local overrides of the committed defaults in .env.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Only variables prefixed with VITE_ reach the client
# bundle, and everything that reaches it is public: never put a secret here.

# Set to false to work against a real API instead of the MSW mock backend.
VITE_ENABLE_MSW=true

# Base URL of the bank API. Ignored while VITE_ENABLE_MSW is true.
VITE_API_BASE_URL=http://localhost:3000/api

VITE_APP_ENV=development
