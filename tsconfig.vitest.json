{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  "include": ["src/**/__tests__/*", "src/test/**/*", "src/mocks/node.ts", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    /*
     * `lib` is inherited from tsconfig.app.json on purpose. Tests run in jsdom,
     * so they need the same DOM and ES2022 globals the app has — blanking it
     * here (the create-vue default) silently removed Object.hasOwn, Array.at and
     * everything else newer than the libs @types/node happens to pull in.
     */
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
